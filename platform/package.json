{
  "name": "the-pall-platform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "pg": "^8.0.0"
  },
  "scripts": {
    "build:packages": "npm run build -w @the-pall/contracts && npm run build -w @the-pall/game-core",
    "dev:web": "npm run dev -w @the-pall/web",
    "dev:api": "npm run build:packages && npm run dev -w @the-pall/api",
    "test:unit": "npm run build:packages && npm run test -w @the-pall/contracts && npm run test -w @the-pall/game-core",
    "check:web": "npm run verify:canonical-copy && npm run verify:dialogue-speakers && npm run verify:dialogue-primary-style && npm run verify:story-immersion && npm run verify:dev-rewind && npm run check -w @the-pall/web",
    "db:up": "docker compose up -d postgres",
    "db:status": "docker compose ps",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "node scripts/db-migrate.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "mail:up": "docker compose up -d mailpit",
    "auth:migrate": "node --env-file=.env --import tsx scripts/auth-migrate.ts",
    "auth:status": "node --env-file=.env scripts/auth-check-schema.mjs",
    "verify:auth-unauthenticated": "node scripts/verify-auth-boundary.mjs",
    "verify:canonical-copy": "node scripts/verify-approved-intro-copy.mjs",
    "verify:dialogue-speakers": "node --import tsx --test scripts/verify-dialogue-speakers.test.ts",
    "verify:dialogue-primary-style": "node scripts/verify-dialogue-primary-style.mjs",
    "verify:story-immersion": "node scripts/verify-story-immersion.mjs",
    "verify:character-catalogue": "node scripts/verify-character-catalogue.mjs",
    "characters:migrate": "node --env-file=.env scripts/characters-migrate.mjs",
    "characters:portraits-migrate": "node --env-file=.env scripts/character-portraits-migrate.mjs",
    "verify:avatar-art": "node scripts/verify-avatar-art.mjs",
    "verify:entry-pages": "node scripts/verify-entry-pages.mjs",
    "verify:account-art": "node scripts/verify-account-art.mjs",
    "verify:introduction-art": "node scripts/verify-introduction-art.mjs",
    "verify:characters-art": "node scripts/verify-characters-art.mjs",
    "verify:character-home": "node scripts/verify-character-home.mjs",
    "verify:welcome": "node scripts/verify-character-welcome.mjs",
    "verify:backgrounds-art": "node scripts/verify-backgrounds-art.mjs",
    "verify:homepage-art": "node scripts/verify-homepage-art.mjs",
    "check:api": "npm run build:packages && npm run check -w @the-pall/api",
    "verify:characters-unauthenticated": "node scripts/verify-characters-unauthenticated.mjs",
    "verify:workshop-assets": "node scripts/verify-workshop-assets.mjs",
    "verify:workshop-inspections": "node scripts/verify-workshop-inspections.mjs",
    "platework:migrate": "node --env-file=.env scripts/platework-migrate.mjs",
    "bellrunner:migrate": "node --env-file=.env scripts/bellrunner-migrate.mjs",
    "missing-stamp:migrate": "node --env-file=.env scripts/missing-stamp-migrate.mjs",
    "second-job:migrate": "node --env-file=.env scripts/second-job-migrate.mjs",
    "wage-claim:migrate": "node --env-file=.env scripts/wage-claim-migrate.mjs",
    "verify:stage-five": "node scripts/verify-stage-five.mjs",
    "verify:stage-five-assets": "node scripts/verify-stage-five-assets.mjs",
    "verify:millhand-work-unauthenticated": "node scripts/verify-millhand-work-unauthenticated.mjs",
    "verify:missing-stamp-unauthenticated": "node scripts/verify-missing-stamp-unauthenticated.mjs",
    "verify:dev-rewind": "node scripts/verify-dev-stage-rewind.mjs",
    "verify:stage-four": "node scripts/verify-stage-four.mjs",
    "verify:stage4-exits": "node scripts/verify-stage4-exits.mjs",
    "verify:depot-art": "node scripts/verify-depot-art.mjs",
    "verify:commerce-art": "node scripts/verify-commerce-art.mjs",
    "verify:scholarship-art": "node scripts/verify-scholarship-art.mjs",
    "verify:stage3-record-art": "node scripts/verify-stage3-record-art.mjs",
    "verify:stage3-workbench-ui": "node scripts/verify-stage3-workbench-ui.mjs",
    "verify:stage4-transport-ui": "node scripts/verify-stage4-transport-ui.mjs",
    "verify:audio-prototype": "node scripts/verify-audio-prototype.mjs",
    "verify:audio-runtime": "node scripts/verify-audio-runtime.mjs",
    "verify:workshop-hud-ambience": "node scripts/verify-workshop-hud-ambience.mjs",
    "verify:council-ambience-asset": "node scripts/verify-council-ambience-asset.mjs",
    "verify:night-alley-ambience-asset": "node scripts/verify-night-alley-ambience-asset.mjs",
    "verify:depot-ambience-asset": "node scripts/verify-depot-ambience-asset.mjs",
    "verify:owner-ui-kit": "node scripts/verify-owner-ui-kit.mjs",
    "combat:migrate": "node --env-file=.env scripts/combat-migrate.mjs",
    "clinic:migrate": "node --env-file=.env scripts/clinic-migrate.mjs",
    "home:migrate": "node --env-file=.env scripts/tutorial-home-migrate.mjs",
    "inventory:migrate": "node --env-file=.env scripts/inventory-migrate.mjs",
    "verify:inventory": "node --import tsx --test scripts/verify-inventory.test.ts",
    "verify:bellrunner-stage1": "node --import tsx --test scripts/verify-bellrunner-stage1.test.ts",
    "verify:bellrunner-stage3": "node --import tsx --test scripts/verify-bellrunner-stage3.test.ts",
    "verify:bellrunner-stage4": "node --import tsx --test scripts/verify-bellrunner-stage4.test.ts",
    "verify:bellrunner-stage3-assets": "node scripts/verify-bellrunner-stage3-assets.mjs",
    "verify:bellrunner-stage4-browser": "node --import tsx scripts/verify-bellrunner-stage4-browser.mjs",
    "verify:bellrunner-layout-browser": "node scripts/verify-bellrunner-layout-browser.mjs",
    "verify:game-shell-browser": "node scripts/verify-game-shell-browser.mjs",
    "verify:millhand-scenes-browser": "node --import tsx scripts/verify-millhand-scenes-browser.mjs",
    "verify:stage-six": "node scripts/verify-stage-six.mjs",
    "verify:stage-seven": "node --import tsx --test scripts/verify-stage-seven.test.ts",
    "verify:stage-eight": "node --import tsx --test scripts/verify-stage-eight.test.ts"
  }
}
