{
  "name": "the-pall-platform",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @the-pall/contracts && npm run build -w @the-pall/game-core",
    "dev:web": "npm run dev -w @the-pall/web",
    "dev:api": "npm run build:packages && npm run dev -w @the-pall/api",
    "test:unit": "npm run build:packages && npm run test -w @the-pall/contracts && npm run test -w @the-pall/game-core",
    "check:web": "npm run verify:canonical-copy && npm run check -w @the-pall/web",
    "db:up": "docker compose up -d postgres",
    "db:status": "docker compose ps",
    "db:stop": "docker compose stop postgres",
    "db:migrate": "node scripts/db-migrate.mjs",
    "verify:api": "node scripts/verify-api.mjs",
    "mail:up": "docker compose up -d mailpit",
    "auth:migrate": "node --env-file=.env --import tsx scripts/auth-migrate.ts",
    "auth:status": "node --env-file=.env scripts/auth-check-schema.mjs",
    "verify:auth-unauthenticated": "node scripts/verify-auth-boundary.mjs",
    "verify:canonical-copy": "node scripts/verify-approved-intro-copy.mjs",
    "verify:character-catalogue": "node scripts/verify-character-catalogue.mjs",
    "characters:migrate": "node --env-file=.env scripts/characters-migrate.mjs",
    "check:api": "npm run build:packages && npm run check -w @the-pall/api",
    "verify:characters-unauthenticated": "node scripts/verify-characters-unauthenticated.mjs",
    "verify:workshop-assets": "node scripts/verify-workshop-assets.mjs",
    "platework:migrate": "node --env-file=.env scripts/platework-migrate.mjs",
    "missing-stamp:migrate": "node --env-file=.env scripts/missing-stamp-migrate.mjs",
    "verify:millhand-work-unauthenticated": "node scripts/verify-millhand-work-unauthenticated.mjs"
  }
}
