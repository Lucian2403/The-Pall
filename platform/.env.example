DATABASE_URL=postgresql://pall_dev:pall_dev_local_only@127.0.0.1:5433/pall_dev
API_HOST=127.0.0.1
API_PORT=8788
# Local-only Better Auth settings. Generate a fresh random 32-byte+ secret; never commit it.
BETTER_AUTH_SECRET=REPLACE_ME_WITH_GENERATED_SECRET
AUTH_BASE_URL=http://127.0.0.1:5173
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=The Pall Local <no-reply@thepall.invalid>

# Production (NODE_ENV=production): required HTTPS origin and encrypted authenticated SMTP
# AUTH_BASE_URL=https://your-game.example
# SMTP_HOST=smtp.example
# SMTP_PORT=587
# SMTP_USER=replace
# SMTP_PASS=replace
# MAIL_FROM=The Pall <no-reply@your-game.example>
# After setting these in production, run NODE_ENV=production npm run auth:migrate
# Better Auth stores rate-limit counters in its database (rateLimit table).
# Provision a monitored SMTP provider, HTTPS reverse proxy, backups and alerts.

# Shared PostgreSQL budgets per API process, not per background or stage.
# GAMEPLAY_DB_POOL_MAX=10
# AUTH_DB_POOL_MAX=4
# Reserve database connections for migrations, maintenance and other processes.
